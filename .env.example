# ContactFlow Full-Stack Environment Configuration
# Never commit real credentials to source control. Configure secrets via AI Studio Secrets Panel or secret manager.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contactflow?schema=public"
REDIS_URL="redis://localhost:6379"

APP_BASE_URL="http://localhost:5173"
API_BASE_URL="http://localhost:4000/api/v1"

SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-string-for-sessions"
TOKEN_ENCRYPTION_KEY="32-byte-base64-or-hex-aes-key-for-refresh-token-encryption"

# Google Cloud OAuth 2.0 Credentials (Gmail API sending scope: https://www.googleapis.com/auth/gmail.send)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/integrations/google/callback"

# Optional Gemini API Key
# GEMINI_API_KEY=MY_GEMINI_API_KEY
